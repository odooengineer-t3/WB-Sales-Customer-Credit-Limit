<odoo>
    <record id="view_credit_limit_approval_wizard_form" model="ir.ui.view">
        <field name="name">credit.limit.approval.wizard.form</field>
        <field name="model">credit.limit.approval.wizard</field>
        <field name="arch" type="xml">
            <form string="Credit Approval Confirmation" version="18.0">
                <sheet>
                    <div class="text-center">
                        <h3>
                            <field name="partner_id" readonly="1"/>
                        </h3>
                        <p>
                            Kindly confirm credit limit approval for this customer.
                        </p>
                        <p>
                            Remaining Credit:
                            <field name="remaining_credit" readonly="1"/>
                        </p>
                    </div>
                </sheet>
                <footer>
                    <button name="action_confirm_credit" type="object" string="OK" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
