<odoo>
    <record id="view_res_config_settings_credit_limit" model="ir.ui.view">
        <field name="name">res.config.settings.credit.limit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='invoicing_setting_container']" position="after">
                <block title="Customer Credit Limit" name="credit_limit_setting_container">
                <setting id="credit_limit_enable" help="customer credit limits.">
                    <field name="enable_customer_credit_limit"/>
                </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
